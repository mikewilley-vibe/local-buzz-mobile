# Local Buzz 757 mobile — environment template.
#
# Copy this file to `.env.local` (git-ignored) and fill in the values for the
# local-buzz-dev Supabase project.
#
# SAFETY: never point this at the production project (ref: vghnfdukyosvvoqrxmok).
# The app throws at startup in development if it detects the production ref.

EXPO_PUBLIC_SUPABASE_URL=https://<your-dev-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
