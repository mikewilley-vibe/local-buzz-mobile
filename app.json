{
  "expo": {
    "name": "Local Buzz 757",
    "slug": "local-buzz-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "localbuzzmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.mikewilley.localbuzz",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "CFBundleDisplayName": "Local Buzz 757",
        "CFBundleName": "Local Buzz 757",
        "NSLocationWhenInUseUsageDescription": "Local Buzz 757 uses location only to place venue pins on the map.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mikewilley.localbuzz",
      "adaptiveIcon": {
        "backgroundColor": "#208AEF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "localbuzzmobile.app",
              "pathPrefix": "/auth"
            },
            {
              "scheme": "https",
              "host": "www.localbuzzmobile.app",
              "pathPrefix": "/auth"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withIosMinDeployment",
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Local Buzz 757 uses location only to place venue pins on the map."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "57c0840c-e493-48bd-a323-58604213179e"
      }
    },
    "owner": "mikewilley"
  }
}
